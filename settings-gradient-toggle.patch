diff --git a/cosmic-settings/src/pages/desktop/panel/gradient.rs b/cosmic-settings/src/pages/desktop/panel/gradient.rs
new file mode 100644
index 0000000..bfa066f
--- /dev/null
+++ b/cosmic-settings/src/pages/desktop/panel/gradient.rs
@@ -0,0 +1,89 @@
+use cosmic::cosmic_config::{Config, ConfigGet, Error};
+use serde::{Deserialize, Serialize};
+
+/// The optional background effect understood by the patched panel. Keeping this
+/// preference separate avoids changing the stock panel configuration schema.
+#[derive(Clone, Debug, PartialEq, Deserialize, Serialize)]
+#[serde(default, deny_unknown_fields)]
+pub(crate) struct Preferences {
+    pub enabled: bool,
+    height: u32,
+    opacity: f32,
+    // Read older preferences without discarding their saved fields.
+    maximized_color: [u8; 3],
+    maximized_opacity: f32,
+}
+
+impl Default for Preferences {
+    fn default() -> Self {
+        Self {
+            enabled: true,
+            height: 96,
+            opacity: 0.4,
+            maximized_color: [36, 38, 42],
+            maximized_opacity: 1.0,
+        }
+    }
+}
+
+impl Preferences {
+    pub fn preset() -> Self {
+        Self {
+            height: 96,
+            opacity: 0.72,
+            maximized_opacity: 0.96,
+            ..Self::default()
+        }
+    }
+
+    pub fn load(config: &Config) -> Result<Option<Self>, Error> {
+        match config.get("top_edge_gradient") {
+            Err(error) if !error.is_err() => Ok(None),
+            value => value,
+        }
+    }
+
+    pub fn read(config: &Config) -> Option<Self> {
+        match Self::load(config) {
+            Ok(value) => value,
+            Err(error) => {
+                tracing::error!(?error, "Could not read panel gradient preferences");
+                None
+            }
+        }
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn toggling_preserves_legacy_appearance_preferences() {
+        let saved: Option<Preferences> = ron::from_str(
+            "Some((height: 187, opacity: 0.61, maximized_color: (10, 20, 30), maximized_opacity: 0.96))"
+        ).unwrap();
+        let mut value = saved.unwrap();
+        assert!(value.enabled);
+        let original = value.clone();
+        value.enabled = false;
+        let encoded = ron::to_string(&Some(value)).unwrap();
+        let mut decoded: Preferences = ron::from_str::<Option<Preferences>>(&encoded)
+            .unwrap()
+            .unwrap();
+        assert!(!decoded.enabled);
+        decoded.enabled = true;
+        assert_eq!(decoded, original);
+    }
+
+    #[test]
+    fn disabled_state_survives_reopening_and_new_presets_keep_four_percent_transparency() {
+        let disabled: Option<Preferences> = ron::from_str(
+            "Some((enabled: false, height: 128, opacity: 0.72, maximized_opacity: 0.96))",
+        )
+        .unwrap();
+        assert!(!disabled.unwrap().enabled);
+        assert_eq!(ron::from_str::<Option<Preferences>>("None").unwrap(), None);
+        assert_eq!(Preferences::preset().maximized_opacity, 0.96);
+    }
+}
